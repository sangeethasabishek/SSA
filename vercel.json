{
  "headers": [
    {
      "source": "/images/blog/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/blog/ai-marketing-guide",
      "destination": "/blog/how-to-use-ai-for-marketing",
      "permanent": true
    }
  ]
}
